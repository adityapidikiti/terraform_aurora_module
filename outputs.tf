output "cluster_id" {
  description = "Identifier of the cluster."
  value       = aws_rds_cluster.this.id
}

output "cluster_arn" {
  description = "ARN of the cluster."
  value       = aws_rds_cluster.this.arn
}

output "cluster_endpoint" {
  description = "Writer endpoint, which should be used for reads and writes that need consistency."
  value       = aws_rds_cluster.this.endpoint
}

output "cluster_reader_endpoint" {
  description = "Reader endpoint, which load balances across the readers."
  value       = aws_rds_cluster.this.reader_endpoint
}

output "cluster_port" {
  description = "Port the cluster listens on."
  value       = aws_rds_cluster.this.port
}

output "database_name" {
  description = "Database created on the cluster, or null."
  value       = aws_rds_cluster.this.database_name
}

output "master_username" {
  description = "Master username."
  value       = aws_rds_cluster.this.master_username
}

output "master_password" {
  description = "Master password, whether generated or supplied. Sensitive."
  value       = local.master_password
  sensitive   = true
}

output "password_generated" {
  description = "Whether the password was generated by the module rather than supplied. Known at plan time."
  # Comparing against a sensitive variable taints the result, even though a
  # boolean leaks nothing. nonsensitive() records that intent explicitly.
  value = nonsensitive(var.master_password == null)
}

output "instance_ids" {
  description = "Identifiers of the cluster instances."
  value       = aws_rds_cluster_instance.this[*].id
}

output "instance_endpoints" {
  description = "Endpoints of the individual cluster instances."
  value       = aws_rds_cluster_instance.this[*].endpoint
}

output "db_subnet_group_name" {
  description = "Name of the DB subnet group in use, whether created or supplied."
  value       = var.db_subnet_group_name != null ? var.db_subnet_group_name : aws_db_subnet_group.this[0].name
}

output "autoscaling_enabled" {
  description = "Whether the read replica autoscaler is attached."
  value       = local.autoscaling_enabled
}

output "deletion_protection" {
  description = "Effective deletion protection, after the prod guard."
  value       = local.deletion_protection
}

output "skip_final_snapshot" {
  description = "Effective final snapshot setting, after the prod guard."
  value       = local.skip_final_snapshot
}

output "tags" {
  description = "Tags applied to the cluster."
  value       = local.tags
}
